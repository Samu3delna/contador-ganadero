# ===== Base de Datos =====
MONGODB_URI=mongodb+srv://tu_usuario:tu_password@cluster0.ejemplo.mongodb.net/contador_ganadero

# ===== Servidor =====
PORT=5000
NODE_ENV=development
JWT_SECRET=secreto_jwt_muy_seguro_y_largo_12345
JWT_EXPIRE=1h

# ===== CORS (URL del frontend en producción — Vercel) =====
FRONTEND_URL=http://localhost:3000

# ===== Email IMAP =====
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=tu_correo@gmail.com
IMAP_PASSWORD=tu_contraseña_de_aplicacion
IMAP_TLS=true

# ===== IA (NVIDIA NIM API) =====
AI_API_KEY=tu_api_key_de_nvidia
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# AI_BASE_URL=https://integrate.api.nvidia.com/v1

# ===== Stripe (Planes y Suscripciones — free | pro | agro) =====
STRIPE_SECRET_KEY=sk_test_tu_clave_secreta
STRIPE_WEBHOOK_SECRET=whsec_tu_webhook_secret
STRIPE_PRICE_FREE=price_free
STRIPE_PRICE_PRO=price_pro
STRIPE_PRICE_AGRO=price_agro
STRIPE_SUCCESS_URL=http://localhost:5173/planes?status=success
STRIPE_CANCEL_URL=http://localhost:5173/planes?status=cancel

# ===== Frontend (para Vercel) =====
# En Vercel, configurar como variable de entorno:
VITE_API_URL=http://localhost:5000/api
# En producción será algo como: https://contador-ganadero.onrender.com/api
