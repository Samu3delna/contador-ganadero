{
  "name": "contador-ganadero",
  "version": "1.0.0",
  "description": "Aplicación MERN para contabilidad ganadera en Costa Rica",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "cd frontend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "dev:email-worker": "npx --yes wrangler@4.113.0 dev --config cloudflare-email-worker/wrangler.jsonc",
    "deploy:email-worker": "npx --yes wrangler@4.113.0 deploy --config cloudflare-email-worker/wrangler.jsonc",
    "start": "node backend/server.js",
    "dev": "node backend/server.js",
    "lint": "cd frontend && npm run lint",
    "test": "npm --prefix backend test && npm --prefix frontend test",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=22.12.0"
  }
}
